# Os valores de ADMIN_PASSWORD e SESSION_SECRET abaixo são placeholders
# INVÁLIDOS DE PROPÓSITO — o mesmo texto que qualquer pessoa pode ler neste
# arquivo público. Em produção (NODE_ENV=production), o boot RECUSA subir
# enquanto eles não forem trocados por valores reais (ver src/lib/db.js e
# src/lib/config-ambiente.js). Em desenvolvimento eles continuam valendo,
# por conveniência.

# Senha do PRIMEIRO acesso ao painel (/admin).
# Depois que a senha for trocada dentro do painel, esta deixa de valer.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do painel.
# Precisa ter pelo menos 32 caracteres em produção.
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-segredo

# Onde o banco SQLite fica salvo. Em produção aponte para um disco persistente.
DATABASE_PATH=./data/barbosa.db

# Fuso horário usado para calcular os horários livres.
TZ=America/Sao_Paulo

# Defina como 1 SOMENTE se o servidor estiver atrás de um proxy reverso
# confiável (nginx, Caddy, Cloudflare etc.) que sobrescreve os headers
# X-Forwarded-For/X-Real-IP — normalmente o mesmo proxy que termina o HTTPS.
# Sem isso, esses headers vêm do próprio cliente e não devem ser usados para
# identificar quem está fazendo a requisição (ver src/lib/limitador.js).
TRUST_PROXY=0
